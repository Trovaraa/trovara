# Telegram customer order bot username (no @). Required for Order on Telegram CTAs.
VITE_TELEGRAM_CUSTOMER_BOT=
# Leave unset in local/prod: shop uses same-origin /shop-api (Vite/Netlify → OS).
# Only set for direct cross-origin calls (requires CORS_ORIGIN on the API).
# VITE_SHOP_API_URL=http://127.0.0.1:3000/shop
# Local OS origin for shop “Open traceability record” links (default http://127.0.0.1:5173).
# VITE_PUBLIC_OS_URL=http://127.0.0.1:5173
# Build-time public Journal endpoint. CI/Netlify use the production default.
# JOURNAL_API_URL=http://127.0.0.1:3000/public/journal
# Server-only contact and product-waitlist API base. Production is configured in netlify.toml.
# MARKETING_LEADS_API_URL=http://127.0.0.1:3000/public/leads
# Server-only newsletter API base. Production is configured in netlify.toml.
# NEWSLETTER_API_URL=http://127.0.0.1:3000/public/newsletter
