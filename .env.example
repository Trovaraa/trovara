# Telegram customer order bot username (no @). Required for Order on Telegram CTAs.
VITE_TELEGRAM_CUSTOMER_BOT=
# Leave unset in local/prod: shop uses same-origin /shop-api (Vite/Netlify → OS).
# Only set for direct cross-origin calls (requires CORS_ORIGIN on the API).
# VITE_SHOP_API_URL=http://127.0.0.1:3000/shop
# Leave unset in local/prod: lot pages use same-origin /lot-api (Vite/Netlify → OS /public/lots).
# Only set for direct cross-origin calls (requires CORS_ORIGIN on the API).
# VITE_LOT_API_URL=http://127.0.0.1:3000/public/lots
# Leave unset in local/prod: brand packs use same-origin /brand-api (Vite/Netlify → OS /public/brand).
# VITE_BRAND_API_URL=http://127.0.0.1:3000/public/brand
# Local OS origin for certificate HTML links and shop URL rewriting (default http://127.0.0.1:5173).
# VITE_PUBLIC_OS_URL=http://127.0.0.1:5173
# Build-time public Journal endpoint. CI/Netlify use the production default.
# JOURNAL_API_URL=http://127.0.0.1:3000/public/journal
# Server-only contact and product-waitlist API base (required for those functions;
# missing → 503). Production is set in netlify.toml [context.production.environment].
# MARKETING_LEADS_API_URL=http://127.0.0.1:3000/public/leads
# Server-only newsletter API base (required; no hardcoded production fallback;
# missing → 503). Production is set in netlify.toml [context.production.environment].
# NEWSLETTER_API_URL=http://127.0.0.1:3000/public/newsletter
# Shared server-only HMAC secret used to forward stable visitor identities to OS.
# Generate 32 random bytes; configure the same value on Netlify and Trovara OS.
# FORM_PROXY_SIGNING_SECRET=
